[Unit]
Description=FishTank PvP API
After=network.target

[Service]
Type=simple
User=fishtank
WorkingDirectory=/home/fishtank/the-snake-tank
EnvironmentFile=/home/fishtank/the-snake-tank/.env
ExecStart=/home/fishtank/the-snake-tank/.venv/bin/uvicorn app_pvp:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
