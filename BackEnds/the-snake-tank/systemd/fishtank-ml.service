[Unit]
Description=FishTank ML API
After=network.target

[Service]
Type=simple
User=fishtank
WorkingDirectory=/opt/fishtank/BackEnds/the-snake-tank
EnvironmentFile=/opt/fishtank/BackEnds/the-snake-tank/.env
ExecStart=/opt/fishtank/BackEnds/the-snake-tank/.venv/bin/uvicorn app_ml:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

# Hardening. The app only ever writes under data/ and models/, so the rest of
# the filesystem is read-only to it. NoNewPrivileges matters most here: these
# services take unauthenticated public input, so a code-execution bug should
# not be able to escalate.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/fishtank/BackEnds/the-snake-tank/data /opt/fishtank/BackEnds/the-snake-tank/models
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
